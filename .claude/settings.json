          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node E:/Project_LM/Label_Defect/.claude/scripts/run_python_hook.cjs E:/Project_LM/Label_Defect/.claude/scripts/gate_exit_check.py",
